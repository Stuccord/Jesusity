# Copy to .env.local for local development, and add the same values in
# Vercel > Project > Settings > Environment Variables for the live site.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never prefix with VITE_ and never share it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack > Settings > API Keys & Webhooks (use sk_test_… until you go live)
PAYSTACK_SECRET_KEY=sk_test_xxx

# Your public site address, used for Paystack's return link
SITE_URL=https://www.your-domain.com
